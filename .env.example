# Local SQLite is the default; this is a separate operational DB, not the ML seed DB.
DATABASE_URL=sqlite:///./backend/lucy.db
APP_ENV=development
# Demo impersonation headers, never production authentication.
# Defaults false when APP_ENV=production or VERCEL is set. Hosted demos must opt in
# explicitly AND use a protected deployment. Hosted SQLite is always rejected.
LUCY_DEMO_AUTH=true
LUCY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LUCY_ALLOW_RESET=true
# Local developer reset only; the browser receives this local demo token.
LUCY_RESET_TOKEN=local-reset
VITE_RESET_TOKEN=local-reset
VITE_API_BASE_URL=/api
# Hosted example: DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Never put database credentials into any VITE_ variable.
